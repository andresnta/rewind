pkgname=rewind
pkgver=0.3.0
pkgrel=1
pkgdesc='Stream, save, and play past NTS Radio episodes'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'yt-dlp' 'ffmpeg')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/rewind "$pkgdir/usr/bin/rewind"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/rewind.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/rewind.svg"
  install -Dm644 "$startdir/rewind.desktop" "$pkgdir/usr/share/applications/rewind.desktop"
}
