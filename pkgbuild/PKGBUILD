pkgname=rewind
pkgver=0.4.2
pkgrel=1
pkgdesc='Stream, save, and play past NTS Radio episodes'
arch=('x86_64' 'aarch64')
license=('MIT')
url='https://github.com/andresnta/rewind'
depends=('qt6-base>=6.12' 'qt6-declarative>=6.12' 'qt6-multimedia>=6.12' 'qt6-wayland>=6.12' 'yt-dlp' 'ffmpeg')
makedepends=('gcc' 'make')
# The repository ships one package; no separate debug symbols.
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/rewind "$pkgdir/usr/bin/rewind"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/rewind.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/rewind.svg"
  install -Dm644 "$startdir/rewind.desktop" "$pkgdir/usr/share/applications/rewind.desktop"
}
